# Append to drivers/tty/serial/Kconfig (inside the serial menu):
config SERIAL_GXE
	tristate "HP iLO3 Gromit-XE UART support"
	depends on OF
	select SERIAL_CORE
	help
	  Driver for the minimal 8-bit UART in the HP iLO 3 "Gromit-XE" BMC ASIC.

config SERIAL_GXE_CONSOLE
	bool "Console on Gromit-XE UART"
	depends on SERIAL_GXE=y
	select SERIAL_CORE_CONSOLE
	select SERIAL_EARLYCON
